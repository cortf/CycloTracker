{
  "name": "cyclotracker",
  "version": "0.0.1",
  "private": true,
  "description": "Visualizes reported Cyclospora cayetanensis infections by U.S. state on a proportional symbol map.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "probe": "tsx scripts/probe-sources.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:summary": "tsx scripts/db-summary.ts",
    "ingest": "tsx scripts/ingest/run.ts",
    "normalize": "tsx scripts/ingest/run.ts --normalize-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "tsx scripts/coverage-report.ts",
    "refresh": "npm run db:migrate && npm run db:seed && INGEST_NO_CACHE=1 npm run ingest && npm run coverage",
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && npm run db:seed && INGEST_NO_CACHE=1 npm run ingest && next build",
    "start": "next start"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "better-sqlite3": "^11.8.1",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "drizzle-orm": "^0.38.3",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/d3-force": "^3.0.10",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
